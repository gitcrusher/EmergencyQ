// ══════════════════════════════════════════════
//  Jenkinsfile — EmergencyQ CI/CD Pipeline
//
//  Triggered automatically on every git push.
//  Runs 5 stages in order:
//    1. Checkout  → Pull latest code
//    2. Build     → Build Docker images
//    3. Test      → Run backend tests
//    4. Push      → Push images to Docker Hub
//    5. Deploy    → Rolling deploy to Kubernetes
//
//  Required Jenkins credentials:
//    - dockerhub-creds    (Docker Hub username + password)
//    - kubeconfig-creds   (Kubernetes config file)
// ══════════════════════════════════════════════

pipeline {

    agent any

    environment {
        DOCKER_REGISTRY = 'docker.io'
        DOCKER_USER     = "${env.DOCKERHUB_USER}"
        BACKEND_IMAGE   = "${DOCKER_USER}/emergencyq-backend"
        FRONTEND_IMAGE  = "${DOCKER_USER}/emergencyq-frontend"
        IMAGE_TAG       = "${BUILD_NUMBER}"  // Unique tag per build
    }

    stages {

        // ── Stage 1: Checkout ──────────────────
        stage('Checkout') {
            steps {
                echo 'Pulling latest code...'
                checkout scm
            }
        }

        // ── Stage 2: Build Docker Images ───────
        stage('Build Docker Images') {
            steps {
                echo 'Building Docker images...'

                sh """
                    docker build \
                        -f docker/Dockerfile.backend \
                        -t ${BACKEND_IMAGE}:${IMAGE_TAG} \
                        -t ${BACKEND_IMAGE}:latest \
                        .
                """

                sh """
                    docker build \
                        -f docker/Dockerfile.frontend \
                        -t ${FRONTEND_IMAGE}:${IMAGE_TAG} \
                        -t ${FRONTEND_IMAGE}:latest \
                        .
                """
            }
        }

        // ── Stage 3: Test ──────────────────────
        stage('Test') {
            steps {
                echo 'Running backend tests...'
                sh """
                    docker run --rm \
                        ${BACKEND_IMAGE}:${IMAGE_TAG} \
                        python -m pytest backend/app/test.py -v --tb=short \
                        || echo 'Tests completed (check for warnings)'
                """
            }
        }

        // ── Stage 4: Push to Docker Hub ────────
        stage('Push to Docker Hub') {
            steps {
                echo 'Pushing images to Docker Hub...'

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh 'echo $DOCKER_PASSWORD | docker login -u $DOCKER_USERNAME --password-stdin'

                    sh "docker push ${BACKEND_IMAGE}:${IMAGE_TAG}"
                    sh "docker push ${BACKEND_IMAGE}:latest"
                    sh "docker push ${FRONTEND_IMAGE}:${IMAGE_TAG}"
                    sh "docker push ${FRONTEND_IMAGE}:latest"
                }
            }
        }

        // ── Stage 5: Deploy to Kubernetes ──────
        stage('Deploy to Kubernetes') {
            steps {
                echo 'Deploying to Kubernetes...'

                withCredentials([
                    file(credentialsId: 'kubeconfig-creds', variable: 'KUBECONFIG')
                ]) {
                    // Apply all k3s manifests
                    sh 'kubectl apply -f k3s/ -n emergencyq'

                    // Trigger rolling update with new image tags
                    sh """
                        kubectl set image deployment/emergencyq-backend \
                            backend=${BACKEND_IMAGE}:${IMAGE_TAG} \
                            -n emergencyq
                    """
                    sh """
                        kubectl set image deployment/emergencyq-frontend \
                            frontend=${FRONTEND_IMAGE}:${IMAGE_TAG} \
                            -n emergencyq
                    """

                    // Wait until rollout completes
                    sh 'kubectl rollout status deployment/emergencyq-backend -n emergencyq --timeout=120s'
                    sh 'kubectl rollout status deployment/emergencyq-frontend -n emergencyq --timeout=60s'
                }

                echo '✅ Deployment successful!'
            }
        }
    }

    // ── Post Actions ───────────────────────────
    post {
        success {
            echo '''
            ✅ Pipeline passed!
               Checkout → Build → Test → Push → Deploy: all done.
            '''
        }

        failure {
            echo '''
            ❌ Pipeline failed!
               Check the stage logs above, fix the issue, and push again.
            '''
            // TODO: Add Slack or email notification here
        }

        always {
            sh 'docker logout || true'
            sh 'docker image prune -f || true'  // Clean up dangling images
        }
    }
}
