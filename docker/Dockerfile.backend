
#  Dockerfile.backend — EmergencyQ

FROM python:3.11-slim

WORKDIR /app

# System deps (psycopg2 ke liye gcc chahiye)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Docker-specific requirements (CPU torch, sirf backend packages)
COPY requirements.docker.txt .

# PyTorch CPU — CPU wheels +cpu suffix ke saath aate hain whl index pe
RUN pip install --no-cache-dir "torch==2.5.1+cpu" --index-url https://download.pytorch.org/whl/cpu

# Baaki sab packages
RUN pip install --no-cache-dir -r requirements.docker.txt

# SpaCy model download
RUN python -m spacy download en_core_web_sm

# App code copy
COPY backend/ ./backend/

ENV PYTHONUTF8=1
ENV PYTHONPATH=/app

EXPOSE 8000

WORKDIR /app/backend
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]