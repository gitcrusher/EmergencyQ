
#  Dockerfile.backend — EmergencyQ


FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .

# Hash entries in requirements.txt cause pip to fail when PyPI updates packages
# Strip all --hash lines and backslash continuations before installing
RUN sed -i 's/ \\$//' requirements.txt && \
    grep -v '^\s*--hash=' requirements.txt > requirements_clean.txt

RUN mkdir -p /pip-tmp

# Install PyTorch CPU version first, then everything else
RUN TMPDIR=/pip-tmp pip install --no-cache-dir torch==2.5.1 --index-url https://download.pytorch.org/whl/cpu && \
    TMPDIR=/pip-tmp pip install --no-cache-dir -r requirements_clean.txt && \
    rm -rf /pip-tmp requirements_clean.txt

COPY backend/ ./backend/

ENV PYTHONUTF8=1
ENV PYTHONPATH=/app/backend

EXPOSE 8000

WORKDIR /app/backend
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]