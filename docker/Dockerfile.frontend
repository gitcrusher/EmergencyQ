# Dockerfile.frontend — EmergencyQ
#
# 2-stage build:
#   Stage 1 → Node.js builds the React app (dist/ folder)
#   Stage 2 → Nginx serves the dist/ folder
#
# Final image is ~25MB (no Node.js, just Nginx + static files)

# ── Stage 1: Build ──────────────────────────────────────
FROM node:20-slim AS builder

WORKDIR /app

# Copy package files first (layer caching — only reinstalls if deps change)
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# Copy source and build
COPY frontend/ .
RUN npm run build


# ── Stage 2: Serve ──────────────────────────────────────
FROM nginx:alpine

# Copy built React files into Nginx's web root
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx config template (uses ${BACKEND_HOST} variable)
COPY docker/nginx.conf /etc/nginx/templates/default.conf.template

# Nginx entrypoint runs envsubst automatically on files in /etc/nginx/templates/
# It substitutes ${BACKEND_HOST} with the actual env var value at startup
# Docker Compose sets: BACKEND_HOST=backend
# Kubernetes sets:     BACKEND_HOST=emergencyq-backend-svc

EXPOSE 80
