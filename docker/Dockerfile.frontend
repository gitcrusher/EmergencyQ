
#  Dockerfile.frontend — EmergencyQ
#
#  2-stage build:
#    Stage 1 → build Node.js (dist/ creates folder)
#    Stage 2 → Nginx serves the dist/ folder
#
#  why 2 stages? Node only for build purpose.
#  Final image contain Nginx + HTML/CSS/JS only = ~25MB


#  STAGE 1: React app build
FROM node:20-slim AS builder

WORKDIR /app

# Package files first for caching
COPY frontend/package.json frontend/package-lock.json ./

# Install dependencies
RUN npm ci

# Copy rest of the code
COPY frontend/ .

# Build React app → dist/ folder contains static files
RUN npm run build


# STAGE 2: Nginx serve
FROM nginx:alpine

# Build files into Nginx folder
COPY --from=builder /app/dist /usr/share/nginx/html

# Nginx config copy (React Router + API proxy)
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Port 80 (normal HTTP)
EXPOSE 80
